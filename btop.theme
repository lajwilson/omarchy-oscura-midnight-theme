# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#D4D4DA"

# Title color for boxes
theme[title]="#D4D4DA"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9B7ECE"

# Background color of selected item in processes box
theme[selected_bg]="#181521"

# Foreground color of selected item in processes box
theme[selected_fg]="#9B7ECE"

# Color of inactive/disabled text
theme[inactive_fg]="#565A63"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#A8A8B0"

# Background color of the percentage meters
theme[meter_bg]="#181521"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#A8A8B0"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#C98FD9"
theme[mem_box]="#3FB488"
theme[net_box]="#E06C75"
theme[proc_box]="#9B7ECE"

# Box divider line and small boxes line color
theme[div_line]="#565A63"

# Temperature graph color (Slate -> Slate -> Rose)
theme[temp_start]="#3FB488"
theme[temp_mid]="#AFA7CC"
theme[temp_end]="#E06C75"

# CPU graph colors (Cyan -> Purple -> Lavender)
theme[cpu_start]="#5CC9C5"
theme[cpu_mid]="#9B7ECE"
theme[cpu_end]="#C98FD9"

# Mem/Disk free meter
theme[free_start]="#C98FD9"
theme[free_mid]="#9B7ECE"
theme[free_end]="#5CC9C5"

# Mem/Disk cached meter
theme[cached_start]="#9B7ECE"
theme[cached_mid]="#5CC9C5"
theme[cached_end]="#C98FD9"

# Mem/Disk available meter
theme[available_start]="#AFA7CC"
theme[available_mid]="#E06C75"
theme[available_end]="#E06C75"

# Mem/Disk used meter (Green -> Cyan -> Purple)
theme[used_start]="#3FB488"
theme[used_mid]="#5CC9C5"
theme[used_end]="#9B7ECE"

# Download graph colors
theme[download_start]="#AFA7CC"
theme[download_mid]="#E06C75"
theme[download_end]="#E06C75"

# Upload graph colors (Green -> Cyan -> Purple)
theme[upload_start]="#3FB488"
theme[upload_mid]="#5CC9C5"
theme[upload_end]="#9B7ECE"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#5CC9C5"
theme[process_mid]="#9B7ECE"
theme[process_end]="#C98FD9"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#000000"
theme[gradient_color_1]="#0A0A0E"
theme[gradient_color_2]="#181521"
theme[gradient_color_3]="#565A63"
theme[gradient_color_4]="#74787F"
theme[gradient_color_5]="#D4D4DA"
theme[gradient_color_6]="#A8A8B0"
theme[gradient_color_7]="#E6E6EA"
